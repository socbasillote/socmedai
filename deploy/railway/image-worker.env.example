# Set these as Railway service variables, not as Docker build arguments.
NODE_ENV=production
MONGODB_URI=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WEB_ORIGIN=https://socmedai-web.vercel.app

# Safe staging profile. API admission must also use mock mode.
IMAGE_GENERATION_WORKER_ENABLED=true
IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_MODEL=storm-mock-image-v1
IMAGE_GENERATION_LIVE_ENABLED=false
IMAGE_GENERATION_LIVE_WORKER_ENABLED=false
IMAGE_GENERATION_LIVE_ROLLOUT=off
IMAGE_GENERATION_LIMITS_ENABLED=true
IMAGE_GENERATION_DAILY_WORKSPACE_LIMIT=10
IMAGE_GENERATION_MAX_ACTIVE_WORKSPACE=2
IMAGE_WORKER_CHANGE_STREAM_ENABLED=true
IMAGE_WORKER_FALLBACK_POLL_INTERVAL_MS=60000
IMAGE_WORKER_RECONNECT_DELAY_MS=5000
