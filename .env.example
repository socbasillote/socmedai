MONGODB_URI=mongodb://127.0.0.1:27017/storm

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


OPENAI_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# ============================================
# FACEBOOK / META INTEGRATION
# ============================================

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_TOKEN_ENCRYPTION_KEY=
FACEBOOK_GRAPH_API_VERSION=v26.0

FACEBOOK_PUBLISHING_ENABLED=true
SCHEDULED_PUBLISHING_ENABLED=true


# ============================================
# IMAGE INTEGRATION
# ============================================

# Phase 12.2 — Image Generation
IMAGE_GENERATION_PROVIDER=openai
IMAGE_GENERATION_LIVE_ENABLED=true
IMAGE_GENERATION_LIVE_ROLLOUT=internal
IMAGE_GENERATION_WORKER_ENABLED=true
IMAGE_GENERATION_HTTP_ENABLED=true

IMAGE_GENERATION_MODEL=gpt-image-2



IMAGE_GENERATION_LIVE_MAX_ACTIVE=1
IMAGE_GENERATION_LIVE_DAILY_LIMIT=20
IMAGE_GENERATION_LIVE_CREDIT_COST=1

# Initial workspace policy
IMAGE_GENERATION_DAILY_WORKSPACE_LIMIT=20
IMAGE_GENERATION_MAX_ACTIVE_WORKSPACE=20

# Same development MongoDB database used by @storm/api.
IMAGE_WORKER_MONGODB_URI=mongodb://127.0.0.1:27017/storm

# New controlled rollout configuration


IMAGE_GENERATION_LIVE_WORKER_ENABLED=true



IMAGE_GENERATION_LIMITS_ENABLED=false
